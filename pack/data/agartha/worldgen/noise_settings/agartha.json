                    "offset": 0,
                    "secondary_depth_range": 0,
                    "surface_type": "floor"
                },
                "then_run": {
                    "type": "minecraft:condition",
                    "if_true": {
                        "type": "minecraft:biome",
                        "biome_is": [
                            "agartha:rainforest"
                        ]
                    },
                    "then_run": {
                        "type": "condition",
                        "if_true": {
